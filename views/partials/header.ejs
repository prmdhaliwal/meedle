<!-- This partial contains the HTML head and navigation that appears on every page -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Dynamic title using EJS expression tag -->
    <!-- The 'title' variable is passed when including this partial -->
    <title>Meedle LMS System</title>
    
    <!-- Bootstrap CSS for styling - loaded from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
        <!-- Responsive Navigation bar -->
        <nav class="navbar navbar-dark navbar-expand-lg bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand" href="/">Home Page</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/edit-details">Change Information</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    
    <!-- Opening container div - content will go here -->
    <div class="container">
    <!-- Bootstrap JS for responsive navbar (dropdown) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>